# L'URL de l'API. En mode développement local (hors Docker), c'est généralement http://localhost:5000
# En mode production avec Docker (via le Nginx proxy), vous pouvez utiliser le chemin relatif '/' ou laisser vide,
# car Nginx redirigera automatiquement /api vers le conteneur backend.
# Pour le développement local uniquement :
VITE_API_URL=http://localhost:5000
