NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://localhost:27017/tt_recruit_system

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM="TT Recruit System <no-reply@ttrecruit.tn>"

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=change_me_internal_api_key

MAX_RESUME_SIZE_MB=5
MAX_AVATAR_SIZE_MB=2