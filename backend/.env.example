# Environnement
NODE_ENV=development
PORT=5000

# Base de données (si avec Docker Compose, utilisez mongodb://mongodb:27017/ttrecruit)
MONGO_URI=mongodb://localhost:27017/ttrecruit

# Sécurité (à remplacer impérativement en production)
JWT_ACCESS_SECRET=your_super_secret_access_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key

# URL du frontend (CORS)
CLIENT_URL=http://localhost:5173

# URL du service AI (si avec Docker Compose, utilisez http://ai-service:8000)
AI_SERVICE_URL=http://localhost:8000

# Clé API partagée avec le service IA
AI_SERVICE_API_KEY=your_secure_ai_api_key

# Configuration Email (optionnelle pour le dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TT Recruit System <no-reply@ttrecruit.tn>"
