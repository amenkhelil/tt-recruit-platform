# Provider du LLM (restera ollama pour ce projet)
LLM_PROVIDER=ollama

# Modèle utilisé par Ollama
LLM_MODEL=qwen2.5:7b

# URL du service local Ollama (utiliser host.docker.internal si via Docker Compose sous Windows/Mac)
# En local classique : http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Clé API partagée avec le backend Node.js
AI_SERVICE_API_KEY=your_secure_ai_api_key

# Variables pour le serveur FastAPI
HOST=0.0.0.0
PORT=8000